[Unit]
Description=SMC Trading Bot Dashboard
Wants=network-online.target
After=network-online.target smc-engine.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/SMC-Bot
EnvironmentFile=/etc/smc-trading-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/SMC-Bot/deploy/start_dashboard.sh
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:/home/ubuntu/SMC-Bot/logs/dashboard.log
StandardError=append:/home/ubuntu/SMC-Bot/logs/dashboard_error.log

[Install]
WantedBy=multi-user.target
