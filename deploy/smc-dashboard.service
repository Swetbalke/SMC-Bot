[Unit]
Description=SMC Trading Bot Dashboard
Wants=network-online.target
After=network-online.target smc-engine.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tradingbot
EnvironmentFile=/etc/smc-trading-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/tradingbot/deploy/start_dashboard.sh
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
