[Unit]
Description=SMC Trading Bot (Delta Demo/Testnet)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/SMC-Bot
EnvironmentFile=/etc/smc-trading-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/SMC-Bot/deploy/start_engine.sh
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:/home/ubuntu/SMC-Bot/logs/engine.log
StandardError=append:/home/ubuntu/SMC-Bot/logs/engine_error.log

[Install]
WantedBy=multi-user.target
